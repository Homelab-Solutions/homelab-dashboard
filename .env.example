# homelab_dashboard - Konfiguration
#
# Aus der Konfiguration des Originals erzeugt: gleiche Schluessel,
# gleiche Reihenfolge - aber OHNE die echten Werte.
#
#     cp .env.example .env
#
# Alles, was mit BITTE_ beginnt, muessen Sie selbst setzen.

# ==========================================================
# Homelab Dashboard - Zugangsdaten und Konfiguration
# Diese Datei enthaelt Secrets und ist in .gitignore ausgeschlossen.
# ==========================================================

# --- Anwendung ---
# Port, auf dem die Anwendung im Container lauscht.
PORT=3002
# Adresse, auf der die Anwendung lauscht. Im Container MUSS hier 0.0.0.0 stehen - mit "localhost" ist sie von ausserhalb des Containers nicht erreichbar.
HOST=0.0.0.0
# production im Betrieb, development beim Entwickeln.
NODE_ENV=production

# --- Datenbank (MariaDB) ---
# STORAGE: auto = MariaDB, bei Verbindungsfehler automatischer Datei-Fallback
#          mysql = nur MariaDB (Start schlaegt ohne DB fehl)
#          file  = nur Datei-Storage unter ./data
STORAGE=auto
# Hostname oder IP Ihres MariaDB-/MySQL-Servers (extern; die Compose-Datei bringt keinen Datenbank-Container mit).
# Ohne Wert gilt 127.0.0.1. Ist die Datenbank nicht erreichbar, nutzt STORAGE=auto den Datei-Storage.
DB_HOST=BITTE_DB_HOST_SETZEN
# Port der Datenbank. MariaDB/MySQL: 3306.
DB_PORT=3306
# Datenbank-Benutzer, den Sie selbst anlegen.
DB_USER=app_user
# SELBST SETZEN - bitte ein neues, langes Zufallsgeheimnis.
DB_PASSWORD=
# Name der Datenbank, die Sie nach INSTALL.md anlegen.
DB_NAME=app_db

# --- Sessions ---
# Schluessel zum Signieren der Session-Cookies. Bei Aenderung werden alle
# Benutzer abgemeldet. Wird dieser Wert geleert, generiert die Anwendung
# automatisch einen Schluessel unter ./data/session.secret
# SELBST SETZEN - bitte ein neues, langes Zufallsgeheimnis.
SESSION_SECRET=
SESSION_TTL_DAYS=30

# --- Erst-Administrator (wird nur angelegt, wenn noch kein Benutzer existiert) ---
# Datenbank-Benutzer, den Sie selbst anlegen.
ADMIN_USER=admin
# SELBST SETZEN - bitte ein neues, langes Zufallsgeheimnis.
ADMIN_PASSWORD=

